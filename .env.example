# Auto Newsletter Development Configuration
# Copy this file to .env and adjust values for your local development.
# NOTE: .env file is ignored by Git, do not commit it.

# Set to true to enable custom updater from your own server
AUTO_NEWSLETTER_DEV_UPDATER=true

# URL to your custom update server JSON file
# Example: https://updates.yourdomain.com/updates/auto-newsletter/update.json
AUTO_NEWSLETTER_UPDATE_URL=https://updates.sprava-wordpress.cz/updates/auto-newsletter/update.json